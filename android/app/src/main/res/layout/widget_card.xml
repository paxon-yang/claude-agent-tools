<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面卡片，苹果风格：没有大标题，一眼看状态、模型、本周额度；会动的地方：状态点、计时器、在跑的进度线、子代理轮播
     Home-screen card, Apple style: no big title; status, model and weekly usage at a glance.
     What moves: the status dot, the turn timer, the activity line, the rotating sub-agents. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_surface"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- 第一块：左边状态 + 模型，右边额度圆环 / top: status and model on the left, the weekly ring on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="6dp">

                    <ProgressBar android:id="@+id/pulse_green" style="@style/Pulse" android:indeterminateDrawable="@drawable/pulse_green" />
                    <ProgressBar android:id="@+id/pulse_red" style="@style/Pulse" android:indeterminateDrawable="@drawable/pulse_red" android:visibility="gone" />
                    <ProgressBar android:id="@+id/pulse_blue" style="@style/Pulse" android:indeterminateDrawable="@drawable/pulse_blue" android:visibility="gone" />
                    <ImageView
                        android:id="@+id/dot_still"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/g_grey"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/st_running"
                    android:textColor="@color/c_green"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/project"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/preview_project"
                    android:textColor="@color/c_label2"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/glyph"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/g_opus"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="O"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:maxLines="1"
                    android:text="@string/preview_model_name"
                    android:textColor="@color/c_label"
                    android:textSize="21sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/preview_sub"
                    android:textColor="@color/c_label2"
                    android:textSize="13sp" />

                <Chronometer
                    android:id="@+id/timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/c_label2"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ring"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:contentDescription="@string/q_week"
                android:src="@drawable/ring_preview" />

            <TextView
                android:id="@+id/quota_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:text="@string/preview_quota_sub"
                android:textColor="@color/c_label3"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 中间：在跑的子代理（轮流显示）/ 等你确认 / 一句话 / middle: running sub-agents (rotating), needs-you, or one line -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:minHeight="34dp">

        <LinearLayout
            android:id="@+id/activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@drawable/row_fill"
            android:orientation="vertical">

            <ViewFlipper
                android:id="@+id/flipper"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:autoStart="true"
                android:flipInterval="3200"
                android:inAnimation="@anim/card_in"
                android:outAnimation="@anim/card_out" />

            <ProgressBar
                android:id="@+id/sweep"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="1dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/c_blue" />
        </LinearLayout>

        <TextView
            android:id="@+id/line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@drawable/row_fill"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:textColor="@color/c_label2"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 页脚 / footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/preview_cost"
            android:textColor="@color/c_label2"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="@string/preview_updated"
            android:textColor="@color/c_label3"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/open"
            android:layout_width="28dp"
            android:layout_height="22dp"
            android:contentDescription="@string/open_board"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:src="@drawable/ic_arrow" />
    </LinearLayout>
</LinearLayout>
